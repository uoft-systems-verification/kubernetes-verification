opam-version: "2.0"
license: "MIT"
maintainer: "Xudong Sun"
authors: "kubernetes-verification authors"
homepage: "https://github.com/uoft-systems-verification/kubernetes-verification"
bug-reports: "https://github.com/uoft-systems-verification/kubernetes-verification/issues"
dev-repo: "git+https://github.com/uoft-systems-verification/kubernetes-verification.git"
version: "dev"
synopsis: "Specs and proofs for Kubernetes controllers"

depends: [
  "perennial"
]

pin-depends: [
  ["perennial.dev"             "git+https://github.com/uoft-systems-verification/perennial.git#45eb46d2bc530c0c5243ae88852e3c966e764372"]

  ## begin indirect
  ["coq-coqutil.dev"           "git+https://github.com/mit-plv/coqutil#cfd88cef005cda5ec400108606d27a0d40578a8f"]
  ["coq-record-update.dev"     "git+https://github.com/tchajed/coq-record-update#1dd231db87451479043a3812dbdbd9658657ff7c"]
  ["rocq-stdpp.dev"            "git+https://gitlab.mpi-sws.org/iris/stdpp#6151984a1e2770649858f9d578023ffc1b337421"]
  ["rocq-iris.dev"             "git+https://gitlab.mpi-sws.org/iris/iris#1e6e3a57d8ad52b880633cc69c979ff7e65d6fbc"]
  ["iris-named-props.dev"      "git+https://github.com/tchajed/iris-named-props#ca663d2709888a789a03edc861b7bde86ddd56e5"]
  ## end
]

build: [make "-j%{jobs}%"]
install: ["go" "tool" "perennial-cli" "install"]
build-env: [
  [GOCACHE = "%{build}%/_build/.gocache"]
]
